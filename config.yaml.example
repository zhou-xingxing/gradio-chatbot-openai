# AI Chatbot Configuration
# 支持多模型配置，每个模型独立设置 API 密钥和参数

models:
  - id: "gpt-4o"
    name: "GPT-4o"
    api_key: "${API_KEY}"
    base_url: "https://api.openai.com/v1"
    supports_thinking: false

# 同一模型ID可以通过不同名称配置多个服务入口
#  - id: "gpt-4o"
#    name: "GPT-4o 内部代理"
#    api_key: "${PROXY_API_KEY}"
#    base_url: "https://proxy.example.com/v1"
#    supports_thinking: false

# 示例：添加更多模型配置
#  - id: "deepseek-chat"
#    name: "DeepSeek Chat"
#    api_key: "${DEEPSEEK_API_KEY}"
#    base_url: "https://api.deepseek.com/v1"
#    supports_thinking: true
#
#  - id: "claude-3-sonnet"
#    name: "Claude 3 Sonnet"
#    api_key: "${ANTHROPIC_API_KEY}"
#    base_url: "https://api.anthropic.com/v1"
#    supports_thinking: false


# 可选配置：显式指定默认模型（不指定时使用 models 列表中的第一个模型）
# default_model_id: "gpt-4o"
# 如果 default_model_id 匹配多个模型，必须同时指定名称
# default_model_name: "GPT-4o"

# context_size: 对话记忆轮数，机器人能记住的最近对话轮数
context_size: 5
system_prompt: "你是一个严谨的 AI 助手，严格遵循： 1. 不知道的直接说不知道，绝不编造 2. 问题不清楚时先向用户确认，不猜测意图 3. 不确定的信息标明不确定性，不假装确定"
